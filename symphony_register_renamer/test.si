
const OP_IO  = 0
const OP_ALU = 1
const OP_JMP = 2
const OP_RAM = 3

def instruction_to_str(instruction: Int) String {

    let mode            = (instruction >> 29) & 0b11
    let opcode          = (instruction >> 24) & 0b1111
    let dest            = (instruction >> 20) & 0b1111
    let a               = (instruction >> 16) & 0b1111
    let b               = (instruction >> 8) & 0b1111
    let immediate       = (instruction >> 28) & 1 != 0
    let immediate_value =  instruction & 0xffff

    var dest_str = ""

    switch dest
        0 { dest_str = "zr" }
        14 { dest_str = "sp" }
        15 { dest_str = "flags" }
        default { dest_str = "r" + str(dest) }


    var a_str = ""

    switch a
        0 { a_str = "zr" }
        14 { a_str = "sp" }
        15 { a_str = "flags" }
        default { a_str = "r" + str(a) }

    var b_str = ""

    if immediate {

        b_str = str(immediate_value)

    } else {

        switch b
            0 { b_str = "zr" }
            14 { b_str = "sp" }
            15 { b_str = "flags" }
            default { b_str = "r" + str(b) }

    }

    switch mode

        OP_IO {

            const NOP      = 0
            const IN       = 1
            const OUT      = 2
            const CONSOLE  = 3
            const TIME_0   = 4
            const TIME_1   = 5
            const TIME_2   = 6
            const TIME_3   = 7
            const COUNTER  = 8
            const KEYBOARD = 9

            switch opcode
                NOP      { return `nop (does nothing)` }
                IN       { return `in {dest_str}` }
                OUT      { return `out {b_str}` }
                CONSOLE  { return `console {b_str}` }
                TIME_0   { return `time_0 {dest_str}` }
                TIME_1   { return `time_1 {dest_str}` }
                TIME_2   { return `time_2 {dest_str}` }
                TIME_3   { return `time_3 {dest_str}` }
                COUNTER  { return `counter {dest_str}` }
                KEYBOARD { return `keyboard {dest_str}` }

        }

        OP_ALU {

            var opcode_str = ""

            switch opcode
                0 { opcode_str = "nand" }
                1 { opcode_str = "or"  }
                2 { opcode_str = "and" }
                3 { opcode_str = "nor" }
                4 { opcode_str = "add" }
                5 { opcode_str = "sub" }
                6 { opcode_str = "xor" }
                7 { opcode_str = "lsl" }
                8 { opcode_str = "lsr" }
                9 { return `cmp {a_str}, {b_str}` }
                10 { opcode_str = "mul" }

            return `{opcode_str} {dest_str}, {a_str}, {b_str}`

        }

        OP_JMP {

            switch opcode
                0b1000  { return `jmp {b_str}` }
                0b0001  { return `je {b_str}` }
                0b1001  { return `jne {b_str}` }

                0b0010  { return `jb {b_str}` }
                0b1010  { return `jae {b_str}` }
                0b0011  { return `jbe {b_str}` }
                0b1011  { return `ja {b_str}` }

                0b0100  { return `jl {b_str}` }
                0b1100  { return `jge {b_str}` }
                0b0101  { return `jle {b_str}` }
                0b1101  { return `jg {b_str}` }

        }

        OP_RAM {

            const LOAD_8    = 0
            const STORE_8   = 1
            const LOAD_16   = 2
            const STORE_16  = 3
            const PLOAD_8   = 4
            const PSTORE_8  = 5
            const PLOAD_16  = 6
            const PSTORE_16 = 7

            switch opcode
                LOAD_8    { return `load_8 {dest_str}, [{b_str}]` }
                STORE_8   { return `store_8 [{b_str}], {a_str}` }
                LOAD_16   { return `load_16 {dest_str}, [{b_str}]` }
                STORE_16  { return `store_16 [{b_str}], {a_str}` }
                PLOAD_8   { return `pload_8 {dest_str}, [{b_str}]` }
                PSTORE_8  { return `pstore_8 [{b_str}], {a_str}` }
                PLOAD_16  { return `pload_16 {dest_str}, [{b_str}]` }
                PSTORE_16 { return `pstore_16 [{b_str}], {a_str}` }

        }


}

def get_random_instruction() Int {

    var mode = random(4)

    let d_vec = random(8) << 20
    let a_vec = random(8) << 16
    let b_vec = random(2) == 0 ? 1 << 28 | random(0xffff) : random(8) << 8

    switch mode


        OP_IO {

            let opcode = random(10)

            switch opcode
                0 { return 0 }
                2 { return OP_IO << 29 | opcode << 24 | b_vec }
                3 { return OP_IO << 29 | opcode << 24 | b_vec }
                default { return OP_IO << 29 | opcode << 24 | d_vec }

        }

        OP_ALU {

            let opcode = random(11)

            if opcode == 9 {

                return OP_ALU << 29 | opcode << 24 | 15 << 20 | a_vec | b_vec

            }

            return OP_ALU << 29 | opcode << 24 | d_vec | a_vec | b_vec

        }
        
        OP_RAM {

            let opcode = random(8)

            switch opcode & 1
                0 {

                    return OP_RAM << 29 | opcode << 24 | d_vec | b_vec

                }
                1 {

                    return OP_RAM << 29 | opcode << 24 | b_vec | a_vec

                }

        }

        OP_JMP {

            var opcode = random(14)
            while opcode != 0b0001 && opcode != 0b1001 && opcode != 0b0010 && opcode != 0b1010 && opcode != 0b0011 && opcode != 0b1011 && opcode != 0b0100 && opcode != 0b1100 && opcode != 0b0101 && opcode != 0b1101 {
                opcode = random(14)
            }

            return OP_JMP << 29 | opcode << 24 | 0b1111 << 20 | ((b_vec >> 2) << 2) 

        }

}


def get_input($scratch_space: [Int], tick: Int, $inputs: [Int]) {

    let instruction_0 = get_random_instruction()
    let instruction_1 = get_random_instruction()
    let instruction_2 = get_random_instruction()

    ui_set_text("description_0", instruction_to_str(instruction_0))
    ui_set_text("description_1", instruction_to_str(instruction_1))
    ui_set_text("description_2", instruction_to_str(instruction_2))

    inputs[0] = random(4)
    inputs[1] = instruction_0
    inputs[2] = instruction_1
    inputs[3] = instruction_2
    inputs[4] = random(0xff) << 2

}

def check_output($scratch_space: [Int], tick: Int, inputs: [Int], outputs: [Int]) TestResult {

    let exe_count = inputs[0]

    let base_d = (inputs[4] >> 2) & 0b111

    {
        let instruction = inputs[1]

        let d = (instruction >> 20) & 0b1111
        let a = (instruction >> 16) & 0b1111
        let b = (instruction >> 8 ) & 0b1111
        let correct_a = scratch_space[a] * <Int>(<U2>(a != 0))
        let correct_b = scratch_space[b] * <Int>(<U2>(b != 0))

        let actual_d =  outputs[0] >> 37
        let actual_a = (outputs[0] >> 34 & 0b111)
        let actual_b = (outputs[0] >> 31 & 0b111)

        let correct_d = base_d * <Int>(<U2>(d != 0))

        if (a == 0 && actual_a != 0) || (b == 0 && actual_b != 0) || (d == 0 && actual_d != 0) {
            set_error(`Don't rename 'zr'. The mismatch appeared in the first instruction.`)
            return fail
        }

        if correct_d != actual_d {

            set_error(`In the first instruction, the 3 bits from 37 to 40 should be the register prefix for the destination. That is supposed to be {correct_d}, not {actual_d}.`)
            return fail

        }

        if correct_a != actual_a {

            set_error(`In the first instruction, the 3 bits from 34 to 36 should be the register prefix for argument A. That is supposed to be {correct_a}, not {actual_a}.`)
            return fail

        }

        if correct_b != actual_b {

            set_error(`In the first instruction, the 3 bits from 31 to 33 should be the register prefix for argument B. That is supposed to be {correct_b}, not {actual_b}.`)
            return fail

        }

        if (instruction & 0x7FFFFFFF) != (outputs[0] & 0x7FFFFFFF) {

            set_error(`You need to copy the 31 bits of the first instruction over to the first output.`)
            return fail
        }

        if exe_count > 0 {

            scratch_space[d] = correct_d

        }

    }

    {
        let instruction = inputs[2]

        let d = (instruction >> 20) & 0b1111
        let a = (instruction >> 16) & 0b1111
        let b = (instruction >> 8 ) & 0b1111
        let correct_a = scratch_space[a] * <Int>(<U2>(a != 0))
        let correct_b = scratch_space[b] * <Int>(<U2>(b != 0))

        let actual_d =  outputs[1] >> 37
        let actual_a = (outputs[1] >> 34 & 0b111)
        let actual_b = (outputs[1] >> 31 & 0b111)

        let correct_d = ((base_d + 1) & 0b111) * <Int>(<U2>(d != 0))

        if (a == 0 && actual_a != 0) || (b == 0 && actual_b != 0) || (d == 0 && actual_d != 0) {
            set_error(`Don't rename 'zr'. The mismatch appeared in the second instruction.`)
            return fail
        }

        if correct_d != actual_d {

            set_error(`In the second instruction, the 3 bits from 37 to 40 should be the register prefix for the destination. That is supposed to be {correct_d}, not {actual_d}.`)
            return fail

        }

        if correct_a != actual_a {

            set_error(`In the second instruction, the 3 bits from 34 to 36 should be the register prefix for argument A. That is supposed to be {correct_a}, not {actual_a}.`)
            return fail

        }

        if correct_b != actual_b {

            set_error(`In the second instruction, the 3 bits from 31 to 33 should be the register prefix for argument B. That is supposed to be {correct_b}, not {actual_b}.`)
            return fail

        }

        if (instruction & 0x7FFFFFFF) != (outputs[1] & 0x7FFFFFFF) {

            set_error(`You need to copy the 31 bits of the second instruction over to the second output.`)
            return fail
        }

        if exe_count > 1 {

            scratch_space[d] = correct_d

        }

    }

    {
        let instruction = inputs[3]

        let d = (instruction >> 20) & 0b1111
        let a = (instruction >> 16) & 0b1111
        let b = (instruction >> 8 ) & 0b1111
        let correct_a = scratch_space[a] * <Int>(<U2>(a != 0))
        let correct_b = scratch_space[b] * <Int>(<U2>(b != 0))

        let actual_d =  outputs[2] >> 37
        let actual_a = (outputs[2] >> 34 & 0b111)
        let actual_b = (outputs[2] >> 31 & 0b111)

        let correct_d = ((base_d + 2) & 0b111) * <Int>(<U2>(d != 0))

        if (a == 0 && actual_a != 0) || (b == 0 && actual_b != 0) || (d == 0 && actual_d != 0) {
            set_error(`Don't rename 'zr'. The mismatch appeared in the third instruction.`)
            return fail
        }

        if correct_d != actual_d {

            set_error(`In the third instruction, the 3 bits from 37 to 40 should be the register prefix for the destination. That is supposed to be {correct_d}, not {actual_d}.`)
            return fail

        }

        if correct_a != actual_a {

            set_error(`In the third instruction, the 3 bits from 34 to 36 should be the register prefix for argument A. That is supposed to be {correct_a}, not {actual_a}.`)
            return fail

        }

        if correct_b != actual_b {

            set_error(`In the third instruction, the 3 bits from 31 to 33 should be the register prefix for argument B. That is supposed to be {correct_b}, not {actual_b}.`)
            return fail

        }

        if (instruction & 0x7FFFFFFF) != (outputs[2] & 0x7FFFFFFF) {

            set_error(`You need to copy the 31 bits of the third instruction over to the third output.`)
            return fail
        }

        if exe_count > 2 {

            scratch_space[d] = correct_d

        }

    }

    if has_ram() {

        var addr = 0

        while addr < 16 {

            if get_ram_value(addr) != scratch_space[addr] {

                set_error(`The RAM is supposed to have the value {scratch_space[addr]} at address {addr}.`)
                return fail

            }

            addr += 1

        }

    } else {

        var reg_idx = 1

        while reg_idx < 16 {

            if get_level_memory(`r{reg_idx} prefix`) != scratch_space[reg_idx] {

                set_error(`The 'r{reg_idx} prefix' non-addressable memory (or memory probe) component is supposed to have the value {scratch_space[reg_idx]},\nor add a RAM component to store register prefixes instead.`)
                return fail

            }

            reg_idx += 1

        }

    }



    if tick == 0xfff {

        if get_delay_score() >= 60 {

            set_error(`Your solution is correct, but delay should be less than 60.`)
            return fail

        }

        return win

    }

}